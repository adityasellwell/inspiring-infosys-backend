DATABASE_URL="mysql://root:yourpassword@localhost:3306/inspiring_infosys"
JWT_SECRET="inspiring-infosys-super-secret-jwt-key-change-this"
PORT=3001
FRONTEND_URL="http://localhost:5173"

# Google Places API — powers the live Google Reviews shown on the homepage.
# Create/enable "Places API (New)" in Google Cloud Console and generate an API key.
GOOGLE_PLACES_API_KEY="your-google-places-api-key"
# The Place ID for the Inspiring Infosys business listing (find it via
# https://developers.google.com/maps/documentation/places/web-service/place-id).
GOOGLE_PLACE_ID="your-google-place-id"
