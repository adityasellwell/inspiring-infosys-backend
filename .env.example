# Environment variables template for Inspiring Infosys Server
# Copy this file to .env and fill in your actual values

# Database Connection
DATABASE_URL="mysql://your_db_user:your_db_password@127.0.0.1:3306/your_database_name"

# JWT Secret
JWT_SECRET="change-this-to-a-strong-random-secret"

# Port
PORT=3001

# Allowed Frontend Origins (comma-separated list for CORS)
FRONTEND_URL="http://localhost:5173"

# SMTP Email Setup
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE="true"
